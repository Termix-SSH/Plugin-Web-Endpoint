{
  "id": "web-endpoint",
  "name": "Web Endpoint",
  "version": "1.2.0",
  "description": "Open a host's web UI inside Termix, directly or over an SSH tunnel.",
  "author": {
    "name": "Termix"
  },
  "license": "Apache-2.0",
  "repository": "https://github.com/Termix-SSH/Plugin-Web-Endpoint",
  "docs": "https://docs.termix.site/plugins/web-endpoint",
  "video": "https://www.youtube.com/watch?v=gY6liAeScYQ",
  "category": "Networking",
  "icon": "Globe",
  "features": [
    "Open a web UI in a Termix tab or its own desktop window",
    "Connect directly, or over an SSH tunnel through the host",
    "Embedded pages never see your Termix login",
    "A web UI panel beside the SSH terminal and a dashboard card to open any web UI"
  ],
  "engine": {
    "termix": ">=26.11.1-0",
    "api": "^1.15"
  },
  "capabilities": [
    "hosts:read",
    "credentials:use",
    "network:serve",
    "ui:surface",
    "desktop:window",
    "operations:provide",
    "ssh:connect",
    "kv:own",
    "users:impersonate",
    "notify:send"
  ],
  "dependencies": {
    "tunnels": "^1.0.0"
  },
  "requires": [
    {
      "service": "tunnels.access",
      "versionRange": "^1.0.0"
    },
    {
      "service": "reverse-proxy.endpoints",
      "versionRange": "^1.0.0",
      "optional": true
    }
  ],
  "contributes": {
    "tabs": [
      {
        "id": "web-endpoint",
        "titleKey": "hosts.tabWebUi",
        "icon": "Globe",
        "openFrom": ["host-context-menu"]
      }
    ],
    "settings": {
      "host": {
        "enableKey": "enableWebUi",
        "enableLabelKey": "hosts.enableWebUi",
        "enableDescriptionKey": "hosts.enableWebUiDesc",
        "fields": [
          {
            "key": "webUiConfig",
            "type": "json",
            "labelKey": "hosts.webUiEndpointsSection",
            "requires": "enableWebUi",
            "defaultable": false
          },
          {
            "key": "alertDown",
            "type": "boolean",
            "labelKey": "settings.host.alertDown.label",
            "descriptionKey": "settings.host.alertDown.description",
            "default": false,
            "requires": "enableWebUi"
          },
          {
            "key": "showPanel",
            "type": "boolean",
            "labelKey": "settings.host.showPanel.label",
            "descriptionKey": "settings.host.showPanel.description",
            "default": true,
            "requires": "enableWebUi"
          }
        ]
      },
      "admin": [
        {
          "key": "allowExposedBind",
          "type": "boolean",
          "labelKey": "settings.admin.allowExposedBind.label",
          "descriptionKey": "settings.admin.allowExposedBind.description",
          "default": false
        },
        {
          "key": "allowServerTargets",
          "type": "boolean",
          "labelKey": "settings.admin.allowServerTargets.label",
          "descriptionKey": "settings.admin.allowServerTargets.description",
          "default": false
        }
      ],
      "user": [
        {
          "key": "companionAutoOpen",
          "type": "boolean",
          "labelKey": "settings.user.companionAutoOpen.label",
          "descriptionKey": "settings.user.companionAutoOpen.description",
          "default": false
        },
        {
          "key": "companionSide",
          "type": "select",
          "labelKey": "settings.user.companionSide.label",
          "descriptionKey": "settings.user.companionSide.description",
          "default": "right",
          "options": [
            {
              "value": "right",
              "labelKey": "settings.user.companionSide.right"
            },
            {
              "value": "left",
              "labelKey": "settings.user.companionSide.left"
            },
            {
              "value": "bottom",
              "labelKey": "settings.user.companionSide.bottom"
            }
          ]
        },
        {
          "key": "companionSize",
          "type": "number",
          "labelKey": "settings.user.companionSize.label",
          "descriptionKey": "settings.user.companionSize.description",
          "min": 240,
          "max": 900,
          "default": 520
        },
        {
          "key": "companionEdgeButton",
          "type": "boolean",
          "labelKey": "settings.user.companionEdgeButton.label",
          "descriptionKey": "settings.user.companionEdgeButton.description",
          "default": true
        }
      ]
    },
    "hostCapability": {
      "key": "enableWebUi",
      "labelKey": "hosts.tabWebUi",
      "editorTab": "general"
    },
    "dashboardCards": [
      {
        "id": "web-endpoints",
        "titleKey": "card.title",
        "icon": "Globe"
      }
    ],
    "permissions": [
      {
        "name": "use",
        "titleKey": "permissions.use.title",
        "descriptionKey": "permissions.use.description",
        "defaultRoles": ["admin", "user"]
      }
    ],
    "operations": {
      "actions": [
        {
          "id": "web-endpoint.check",
          "titleKey": "operations.check.title",
          "icon": "Globe",
          "scope": "host",
          "risk": "read",
          "permission": "use",
          "hostAccess": "connect",
          "when": {
            "settings": {
              "enableWebUi": true
            }
          },
          "surfaces": {
            "assistant": true,
            "mcp": true
          }
        }
      ],
      "signals": [
        {
          "id": "web-endpoint.up",
          "titleKey": "operations.up.title",
          "read": "web-endpoint.check",
          "scope": "host",
          "kind": "status",
          "refreshSec": 300
        }
      ]
    }
  },
  "locales": "locales",
  "platforms": ["linux", "win32", "darwin"]
}
